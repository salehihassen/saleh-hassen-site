# Railpack picks this up instead of its default Caddyfile for static Node sites.
# Based on railpack's core/providers/node/Caddyfile.template; {{.DIST_DIR}} is
# filled in at build time.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # trust railway's proxy
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Astro puts a content hash in every /_astro/ filename, so a file at a given
	# URL never changes. Cache those for a year without re-checking.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (pages, favicon): browsers may keep a copy but must check
	# with us before using it. That check is a cheap 304 when nothing changed,
	# and a fresh page pointing at the new CSS/JS right after a deploy.
	@unhashed not path /_astro/*
	header @unhashed Cache-Control "no-cache"

	root * {{.DIST_DIR}}

	encode {
		gzip
		zstd
	}

	# This is a multi-page site, so no fallback to /index.html: a missing page
	# or asset gets a real 404 instead of a 200 HTML page in its place.
	try_files {path} {path}.html {path}/index.html

	file_server {
		hide .git
		hide .env*
	}

	handle_errors {
		header Cache-Control "no-cache"
		rewrite * /{err.status_code}.html
		file_server
	}
}
