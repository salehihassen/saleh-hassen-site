---
import { getCollection } from "astro:content";

import ContactCTA from "../components/ContactCTA.astro";
import EntryRow from "../components/EntryRow.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Pill from "../components/Pill.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Skills from "../components/Skills.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../resources/portrait.jpg";

const projects = (await getCollection("work"))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
    .slice(0, 4);

const posts = (await getCollection("blog"))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
    .slice(0, 3);
---

<BaseLayout>
    <section class="mx-auto w-full max-w-5xl px-6 pb-20 pt-14 sm:pt-20">
        <div
            class="grid items-center gap-10 sm:grid-cols-[1fr_0.72fr] sm:gap-10 md:gap-14"
        >
            <div class="deal-in" style="--deal-index: 0">
                <Hero
                    title="Hi, I'm Saleh"
                    tagline="I'm a Software Engineer based in Northern Virginia."
                >
                    <div class="flex flex-wrap gap-2 pt-2">
                        <Pill>
                            <Icon icon="code" size="1.1em" />Web Development
                        </Pill>
                        <Pill>
                            <Icon
                                icon="cloud"
                                size="1.1em"
                                viewBox="0 0 24 24"
                            />Cloud Infrastructure
                        </Pill>
                        <Pill>
                            <Icon
                                icon="brain-circuit"
                                size="1.1em"
                                viewBox="0 0 24 24"
                            />Applied AI
                        </Pill>
                    </div>
                </Hero>
            </div>

            <div
                class="deal-in mx-auto w-full max-w-xs sm:max-w-sm"
                style="--deal-index: 1"
            >
                <img
                    alt="Saleh Hassen smiling in a gray suit while holding an Umbrella."
                    width={portrait.width}
                    height={portrait.height}
                    src={portrait.src}
                    class="aspect-[4/5] w-full rounded-[1.5rem] object-cover object-[center_30%] shadow-xl shadow-ink/10 sm:rounded-[2.5rem] lg:rounded-[4.5rem] dark:shadow-black/40"
                />
            </div>
        </div>
    </section>

    <div class="border-y border-rail bg-surface">
        <div class="mx-auto w-full max-w-5xl px-6 py-16 sm:py-20">
            <Skills />
        </div>
    </div>

    <section class="mx-auto w-full max-w-5xl space-y-6 px-6 py-16 sm:py-20">
        <SectionHeader
            title="Selected Work"
            tagline="Here's some of my previous work over the past few years."
            href="/work/"
            linkLabel="View All"
        />
        <ul>
            {
                projects.map((project) => (
                    <EntryRow entry={project} base="work" />
                ))
            }
        </ul>
    </section>

    <section class="mx-auto w-full max-w-5xl space-y-6 px-6 pb-20 sm:pb-24">
        <SectionHeader title="Blog" href="/blog/" linkLabel="View All" />
        <ul>
            {posts.map((post) => <EntryRow entry={post} base="blog" />)}
        </ul>
    </section>

    <ContactCTA />
</BaseLayout>
