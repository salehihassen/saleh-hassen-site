---
import { getCollection } from "astro:content";

import ContactCTA from "../components/ContactCTA.astro";
import EntryRow from "../components/EntryRow.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
    title="Blog | Saleh Hassen"
    description="A few posts written by me on different interests."
>
    <section class="mx-auto w-full max-w-5xl space-y-10 px-6 pb-20 pt-14 sm:pt-20">
        <Hero
            title="Blog"
            tagline="A few posts written by me on different interests. My promise: none of the following writing was written by Gen AI."
        />
        <ul>
            {posts.map((post) => <EntryRow entry={post} base="blog" />)}
        </ul>
    </section>
    <ContactCTA />
</BaseLayout>
