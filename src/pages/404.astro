---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import notFound from "../resources/not_found.jpeg";
---

<BaseLayout title="Not Found" description="404 Error — this page was not found">
    <section class="mx-auto w-full max-w-5xl space-y-10 px-6 pb-24 pt-14 sm:pt-20">
        <Hero title="Page Not Found" tagline="Not found" />
        <img
            alt=""
            src={notFound.src}
            width={notFound.width}
            height={notFound.height}
            class="mx-auto aspect-[4/3] w-full max-w-xl rounded-sm border border-rail object-cover"
        />
    </section>
</BaseLayout>
