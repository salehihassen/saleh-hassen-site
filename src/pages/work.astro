---
import { getCollection } from "astro:content";

import ContactCTA from "../components/ContactCTA.astro";
import EntryRow from "../components/EntryRow.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("work")).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
    title="My Work | Saleh Hassen"
    description="Learn about Saleh Hassen's most recent projects"
>
    <section class="mx-auto w-full max-w-5xl space-y-10 px-6 pb-20 pt-14 sm:pt-20">
        <Hero
            title="My Work"
            tagline="See my most recent projects below to get an idea of my past experience."
        />
        <ul>
            {projects.map((project) => <EntryRow entry={project} base="work" />)}
        </ul>
    </section>
    <ContactCTA />
</BaseLayout>
