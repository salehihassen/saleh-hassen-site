---
interface Props {
    href: string;
    variant?: "solid" | "quiet";
}

const { href, variant = "solid" } = Astro.props;

const variants = {
    solid: "border-accent bg-accent text-page hover:bg-transparent hover:text-accent",
    quiet: "border-rail text-ink hover:border-accent hover:text-accent",
};
---

<a
    href={href}
    class:list={[
        "inline-flex items-center justify-center gap-2 rounded-sm border px-5 py-2.5 font-mono text-meta uppercase tracking-[0.14em] transition-colors duration-200",
        variants[variant],
    ]}
>
    <slot />
</a>
