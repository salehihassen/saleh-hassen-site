---
interface Props {
    href: string;
    variant?: "solid" | "quiet";
}

const { href, variant = "solid" } = Astro.props;

const variants = {
    solid: "border-accent bg-accent text-page shadow-lg shadow-accent/20 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-accent/25",
    quiet: "border-rail bg-surface text-ink hover:border-accent/50 hover:text-accent",
};
---

<a
    href={href}
    class:list={[
        "shine relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-full border px-5 py-2.5 text-[0.95rem] font-medium transition duration-300 ease-out-soft",
        variants[variant],
    ]}
>
    <slot />
</a>
