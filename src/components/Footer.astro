---
import Icon from "./Icon.astro";

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-rail">
    <div
        class="mx-auto flex w-full max-w-5xl flex-col gap-4 px-6 py-10 font-mono text-meta uppercase tracking-[0.14em] text-faint sm:flex-row sm:items-center sm:justify-between"
    >
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
            <p class="inline-flex items-center gap-2">
                Designed &amp; Developed with <a
                    href="https://astro.build/"
                    class="transition-colors duration-200 hover:text-accent"
                    >Astro</a
                >
                <Icon icon="rocket-launch" size="1.1em" />
            </p>
            <p>&copy; {currentYear} Saleh Hassen</p>
        </div>
        <div class="flex flex-wrap gap-5">
            <a
                href="https://github.com/salehihassen"
                class="transition-colors duration-200 hover:text-accent">GitHub</a
            >
            <a
                href="https://www.linkedin.com/in/saleh-hassen/"
                class="transition-colors duration-200 hover:text-accent"
                >LinkedIn</a
            >
        </div>
    </div>
</footer>
