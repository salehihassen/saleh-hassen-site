---
import Eyebrow from "./Eyebrow.astro";

interface Props {
    title: string;
    tagline?: string;
    eyebrow?: string;
}

const { eyebrow, tagline, title } = Astro.props;
---

<div class="space-y-4">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <h1 class="text-display-md max-w-[20ch]">{title}</h1>
    {
        tagline && (
            <p class="max-w-[58ch] text-lg leading-relaxed text-muted">
                {tagline}
            </p>
        )
    }
    <slot />
</div>
