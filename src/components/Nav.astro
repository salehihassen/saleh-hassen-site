---
import Icon from "./Icon.astro";
import type { iconPaths } from "./IconPaths";
import ThemeToggle from "./ThemeToggle.astro";

const textLinks: { label: string; href: string }[] = [
    { label: "Home", href: "/" },
    { label: "Work", href: "/work/" },
    { label: "Blog", href: "/blog/" },
    { label: "About", href: "/about/" },
];

const iconLinks: {
    label: string;
    href: string;
    icon: keyof typeof iconPaths;
}[] = [
    {
        label: "GitHub",
        href: "https://github.com/salehihassen",
        icon: "github-logo",
    },
    {
        label: "LinkedIn",
        href: "https://www.linkedin.com/in/saleh-hassen/",
        icon: "linkedin-logo",
    },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
    let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
    if (pathname.at(0) !== "/") pathname = "/" + pathname;
    if (pathname.at(-1) !== "/") pathname += "/";
    return pathname === href || (href !== "/" && pathname.startsWith(href));
};

const linkClass =
    "relative block py-1 font-mono text-meta uppercase tracking-[0.14em] text-muted transition-colors duration-200 hover:text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-200 hover:after:scale-x-100 aria-[current=page]:text-ink aria-[current=page]:after:scale-x-100";
---

<header
    class="sticky top-0 z-50 border-b border-rail bg-page/85 backdrop-blur-md"
>
    <nav
        class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-6 py-4"
        aria-label="Main"
    >
        <a
            href="/"
            class="flex items-center gap-2.5 font-display text-[0.95rem] font-semibold tracking-tight text-ink"
        >
            <Icon
                icon="terminal-window"
                size="1.15rem"
                class="text-accent"
            />
            Saleh Hassen
        </a>

        <div class="flex items-center gap-3">
            <!-- Shown by default so the menu still works without JS; the custom
                 element below hides it and takes over on small screens. -->
            <div id="menu-content" class="contents">
                <ul class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-7">
                    {
                        textLinks.map(({ label, href }) => (
                            <li>
                                <a
                                    aria-current={
                                        isCurrentPage(href) ? "page" : null
                                    }
                                    class={linkClass}
                                    href={href}
                                >
                                    {label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <span aria-hidden="true" class="hidden h-4 w-px bg-rail sm:block"
            ></span>

            <div class="hidden items-center gap-1 sm:flex">
                {
                    iconLinks.map(({ href, icon, label }) => (
                        <a
                            href={href}
                            class="p-1.5 text-faint transition-colors duration-200 hover:text-accent"
                        >
                            <span class="sr-only">{label}</span>
                            <Icon icon={icon} size="1.05rem" />
                        </a>
                    ))
                }
            </div>

            <ThemeToggle />

            <menu-button class="sm:hidden">
                <template>
                    <button
                        class="flex items-center rounded-sm border border-rail p-1.5 text-muted transition-colors duration-200 hover:text-ink"
                        aria-expanded="false"
                        aria-controls="menu-content"
                    >
                        <span class="sr-only">Menu</span>
                        <Icon icon="list" size="1.1rem" />
                    </button>
                </template>
            </menu-button>
        </div>
    </nav>
</header>

<script>
    class MenuButton extends HTMLElement {
        constructor() {
            super();

            // Inject the toggle only when JS runs; without it the links stay visible.
            this.appendChild(
                this.querySelector("template")!.content.cloneNode(true),
            );
            const btn = this.querySelector("button")!;
            const menu = document.getElementById("menu-content")!;

            const setExpanded = (expand: boolean) => {
                btn.setAttribute("aria-expanded", expand ? "true" : "false");
                menu.className = expand
                    ? "absolute inset-x-0 top-full border-b border-rail bg-page px-6 py-4 shadow-lg sm:contents"
                    : "hidden sm:contents";
            };

            btn.addEventListener("click", () =>
                setExpanded(btn.getAttribute("aria-expanded") !== "true"),
            );

            // On wide screens the links are always shown and the button is gone.
            const wide = window.matchMedia("(min-width: 40rem)");
            const handleViewports = (
                e: MediaQueryList | MediaQueryListEvent,
            ) => {
                setExpanded(e.matches);
                btn.hidden = e.matches;
            };
            handleViewports(wide);
            wide.addEventListener("change", handleViewports);
        }
    }
    customElements.define("menu-button", MenuButton);
</script>
