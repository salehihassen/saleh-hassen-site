---
import CallToAction from "./CallToAction.astro";
import Icon from "./Icon.astro";
---

<aside class="border-y border-rail bg-surface">
    <div
        class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-6 py-14 sm:flex-row sm:items-center sm:justify-between"
    >
        <h2 class="text-display-sm max-w-[18ch]">
            Interested in working together?
        </h2>
        <CallToAction href="https://www.linkedin.com/in/saleh-hassen/">
            Connect on LinkedIn
            <Icon icon="linkedin-logo" size="1.1em" />
        </CallToAction>
    </div>
</aside>
