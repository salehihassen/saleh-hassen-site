---
import Icon from "./Icon.astro";

const skills: { icon: "terminal-window" | "strategy"; title: string; body: string }[] = [
    {
        icon: "terminal-window",
        title: "End-to-end Owner",
        body: "Built and maintained production systems: frontend, backend, databases, authentication, and more.",
    },
    {
        icon: "strategy",
        title: "Strategy-Minded",
        body: "Coordinates with stakeholders on projects to provide effective business value.",
    },
];
---

<section class="grid gap-10 sm:grid-cols-2 sm:gap-16">
    {
        skills.map(({ icon, title, body }) => (
            <div class="space-y-3">
                <Icon icon={icon} size="1.75rem" class="text-accent" />
                <h2 class="text-display-sm">{title}</h2>
                <p class="max-w-[42ch] text-muted">{body}</p>
            </div>
        ))
    }
</section>
