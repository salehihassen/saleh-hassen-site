---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import Pill from "./Pill.astro";
import { formatDate } from "../utils/entry";

interface Props {
    entry: CollectionEntry<"work"> | CollectionEntry<"blog">;
    base: "work" | "blog";
}

const { entry, base } = Astro.props;
const { data, id } = entry;
---

<li class="reveal">
    <a
        href={`/${base}/${id}`}
        class="spotlight group -mx-2 grid grid-cols-[auto_1fr] items-start gap-x-4 gap-y-3 rounded-[var(--radius-card)] border border-transparent px-3 py-5 transition duration-300 ease-out-soft hover:border-rail hover:bg-surface/70 sm:-mx-4 sm:gap-x-6 sm:px-4 md:grid-cols-[5.5rem_1fr_auto] md:items-center"
    >
        <img
            src={data.img.src}
            width={data.img.width}
            height={data.img.height}
            alt={data.img_alt || ""}
            loading="lazy"
            decoding="async"
            class="aspect-[5/4] w-14 rounded-xl border border-rail object-cover opacity-85 saturate-[0.7] transition duration-500 ease-out-soft group-hover:scale-[1.04] group-hover:opacity-100 group-hover:saturate-100 sm:w-[5.5rem]"
        />

        <div class="min-w-0 space-y-1.5">
            <h3
                class="font-display text-lg font-semibold text-ink transition-colors duration-200 group-hover:text-accent sm:text-xl"
            >
                {data.title}
            </h3>
            <p class="max-w-[62ch] text-[0.95rem] leading-relaxed text-muted">
                {data.description}
            </p>
            <div class="flex flex-wrap gap-1.5 pt-1">
                {data.tags.map((tag) => <Pill>{tag}</Pill>)}
            </div>
        </div>

        <div
            class="col-span-2 flex items-center gap-3 font-mono text-meta text-faint tabular-nums md:col-span-1 md:justify-end"
        >
            <time datetime={data.publishDate.toISOString()}>
                {formatDate(data.publishDate)}
            </time>
            <Icon
                icon="arrow-right"
                size="1.1rem"
                class="text-accent opacity-60 transition duration-300 ease-out-soft group-hover:translate-x-1 group-hover:opacity-100"
            />
        </div>
    </a>
</li>
