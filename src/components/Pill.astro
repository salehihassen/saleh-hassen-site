---
interface Props {
    /** `accent` marks topics and tags; `signal` is reserved for status. */
    tone?: "accent" | "signal";
    class?: string;
}

const { tone = "accent", class: className = "" } = Astro.props;

const tones = {
    accent: "border-accent/35 bg-accent-soft text-accent",
    signal: "border-signal/35 bg-signal-soft text-signal",
};
---

<span
    class:list={[
        "inline-flex items-center gap-1.5 whitespace-nowrap rounded-xs border px-2 py-1 font-mono text-meta uppercase tracking-[0.14em]",
        tones[tone],
        className,
    ]}
>
    <slot />
</span>
