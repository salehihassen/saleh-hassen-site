---
interface Props {
    /** `accent` marks topics and tags; `signal` is reserved for status. */
    tone?: "accent" | "signal";
    class?: string;
}

const { tone = "accent", class: className = "" } = Astro.props;

const tones = {
    accent: "border-accent/20 bg-accent-soft/70 text-accent",
    signal: "border-signal/25 bg-signal-soft/70 text-signal",
};
---

<span
    class:list={[
        "inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-2.5 py-0.5 text-[0.8rem] font-medium leading-6",
        tones[tone],
        className,
    ]}
>
    <slot />
</span>
