---
import Icon from "./Icon.astro";

const options = [
    { value: "system", label: "System theme", icon: "monitor" },
    { value: "light", label: "Light theme", icon: "sun" },
    { value: "dark", label: "Dark theme", icon: "moon-stars" },
] as const;
---

<theme-toggle>
    <div
        role="radiogroup"
        aria-label="Theme"
        class="flex items-center gap-0.5 rounded-full border border-rail p-0.5"
    >
        {
            options.map(({ value, label, icon }) => (
                <button
                    type="button"
                    role="radio"
                    aria-checked={value === "system" ? "true" : "false"}
                    tabindex={value === "system" ? "0" : "-1"}
                    data-value={value}
                    title={label}
                    class="flex items-center rounded-full p-1.5 text-faint transition-colors duration-200 hover:text-accent aria-checked:bg-accent-soft aria-checked:text-accent"
                >
                    <span class="sr-only">{label}</span>
                    <Icon icon={icon} size="0.95rem" />
                </button>
            ))
        }
    </div>
</theme-toggle>

<script>
    // The inline script in MainHead.astro applies the theme. This pill only
    // saves the visitor's choice and shows which one is active.
    const KEY = "theme-pref";

    class ThemeToggle extends HTMLElement {
        buttons = [...this.querySelectorAll<HTMLButtonElement>("[role=radio]")];

        connectedCallback() {
            this.buttons.forEach((button, i) => {
                button.addEventListener("click", () =>
                    this.choose(button.dataset.value!),
                );
                button.addEventListener("keydown", (e) => {
                    const step =
                        e.key === "ArrowRight" || e.key === "ArrowDown"
                            ? 1
                            : e.key === "ArrowLeft" || e.key === "ArrowUp"
                              ? -1
                              : 0;
                    if (!step) return;
                    e.preventDefault();
                    const next =
                        this.buttons[
                            (i + step + this.buttons.length) %
                                this.buttons.length
                        ];
                    next.focus();
                    this.choose(next.dataset.value!);
                });
            });

            document.addEventListener("themechange", this.sync);
            this.sync();
        }

        disconnectedCallback() {
            document.removeEventListener("themechange", this.sync);
        }

        choose(value: string) {
            try {
                if (value === "system") localStorage.removeItem(KEY);
                else localStorage.setItem(KEY, value);
            } catch {}
            document.dispatchEvent(new CustomEvent("themeprefchange"));
        }

        sync = () => {
            const pref = document.documentElement.dataset.themePref ?? "system";
            for (const button of this.buttons) {
                const on = button.dataset.value === pref;
                button.setAttribute("aria-checked", String(on));
                button.tabIndex = on ? 0 : -1;
            }
        };
    }
    customElements.define("theme-toggle", ThemeToggle);
</script>
